# Environment consumed by the spark-master container (radar pipeline runs).
# Values here mirror bigdata/config.py defaults; DB creds match compose.
RADAR_STORAGE=hdfs
HDFS_NAMENODE=hdfs://namenode:9000
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=aid_dras
PYSPARK_PYTHON=python3
